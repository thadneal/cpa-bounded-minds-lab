<Window x:Class="Cpa.BoundedMindsLab.Desktop.MetricPlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cpa.BoundedMindsLab.Desktop.Controls"
        Title="CPA Bounded Minds Laboratory v0.5.2 - Maximized graph"
        Width="1440"
        Height="900"
        MinWidth="760"
        MinHeight="500"
        WindowState="Maximized"
        SourceInitialized="WindowSourceInitialized">
    <Grid Margin="8" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="MetricText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="FocusText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SelectionBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SeedText" Text="SEED --" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="2" Content="Show all" Click="ShowAllClicked" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Show every series key for the selected metric" />
                <Button Grid.Column="3" Content="Hide all" Click="HideAllClicked" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Hide every series key for the selected metric" />
                <Button Grid.Column="4" Content="Close maximized graph" Click="CloseClicked" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <controls:FastMetricPlot x:Name="MetricPlot" />
        </Border>
    </Grid>
</Window>
